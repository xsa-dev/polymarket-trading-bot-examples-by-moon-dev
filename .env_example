# 🌙 Moon Dev - .env_example
# Copy this file to .env and fill in YOUR OWN keys.
# NEVER commit your real .env — it is gitignored on purpose. Keep it that way.
# Nobody is handing you a plug-and-play money printer; these are just the slots
# the bots read from. Not financial advice. Use at your own risk.

# --- Polymarket account (bots use the _AUG14 suffix — rename in code or match it here) ---
# Wallet private key (Polygon). Guard this with your life.
PRIVATE_KEY_AUG14=your_wallet_private_key_here
# Wallet public address (the funder / proxy address)
PUBLIC_KEY_AUG14=your_wallet_public_address_here

# --- Polymarket CLOB API credentials (create/derive via py_clob_client_v2) ---
API_KEY_AUG14=your_clob_api_key_here
API_SECRET_AUG14=your_clob_api_secret_here
PASSPHRASE_AUG14=your_clob_passphrase_here

# --- Moon Dev API (liquidation + tick feeds for liq_cascade_chaser / streak_snapper) ---
# You need your own key or your own equivalent data feed.
MOONDEV_API_KEY=your_moondev_api_key_here
